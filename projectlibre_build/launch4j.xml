<?xml version="1.0" encoding="UTF-8"?>
<launch4jConfig>
  <dontWrapJar>false</dontWrapJar>
  <headerType>gui</headerType>
  <jar>dist\projectlibre.jar</jar>
  <outfile>dist\projectlibre.exe</outfile>
  <errTitle></errTitle>
  <cmdLine>-Xms128m -Xmx768m</cmdLine>
  <chdir>.</chdir>
  <priority>normal</priority>
  <downloadUrl>https://aka.ms/download-jdk/microsoft-jdk-21.0.6-windows-x64.msi</downloadUrl>
  <supportUrl></supportUrl>
  <stayAlive>false</stayAlive>
  <restartOnCrash>false</restartOnCrash>
  <manifest></manifest>
  <icon>resources\wix\msi_images\projectlibre.ico</icon>
  <jre>
    <path>jre</path>
    <requiresJdk>false</requiresJdk>
    <requires64Bit>false</requires64Bit>
    <minVersion>11</minVersion>
    <maxVersion>23</maxVersion>
    <!-- Groovy 1.0 formulas need these on JDK 17+ (see add_opens in build.xml) -->
    <opt>--add-opens=java.base/java.lang=ALL-UNNAMED</opt>
    <opt>--add-opens=java.base/java.util=ALL-UNNAMED</opt>
    <opt>--add-opens=java.base/java.text=ALL-UNNAMED</opt>
    <opt>--add-opens=java.base/java.math=ALL-UNNAMED</opt>
    <opt>--add-opens=java.base/java.io=ALL-UNNAMED</opt>
    <opt>--add-opens=java.desktop/java.awt=ALL-UNNAMED</opt>
    <opt>--add-opens=java.desktop/javax.swing=ALL-UNNAMED</opt>
  </jre>
</launch4jConfig>